@model HospitalMVC.Models.Appointment

@{
    ViewData["Title"] = "Delete Appointment";
}

<h1>Delete Appointment</h1>

<h3>
    Are you sure you want to delete this appointment?
</h3>

<hr />

<dl class="row">

    <dt class="col-sm-3">
        Patient Id
    </dt>

    <dd class="col-sm-9">
        @Model.PatientId
    </dd>

    <dt class="col-sm-3">
        Doctor Id
    </dt>

    <dd class="col-sm-9">
        @Model.DoctorId
    </dd>

    <dt class="col-sm-3">
        Appointment Date
    </dt>

    <dd class="col-sm-9">
        @Model.AppointmentDate.ToString("dd-MM-yyyy HH:mm")
    </dd>

    <dt class="col-sm-3">
        Status
    </dt>

    <dd class="col-sm-9">
        @Model.Status
    </dd>

    <dt class="col-sm-3">
        Reason
    </dt>

    <dd class="col-sm-9">
        @Model.Reason
    </dd>

</dl>

<form asp-action="Delete" method="post">

    <input type="hidden"
           asp-for="Id" />

    <button type="submit"
            class="btn btn-danger">
        Delete
    </button>

    <a asp-action="Index"
       class="btn btn-secondary">
        Cancel
    </a>

</form>