@model aug_17_mvc.Models.Appointment

@{
    ViewData["Title"] = "Delete Appointment";
}

<h1>Delete Appointment</h1>

<div class="alert alert-danger">
    Are you sure you want to delete this appointment?
</div>

<div class="card">
    <div class="card-body">

        <p>
            <strong>Appointment Id:</strong>
            @Model.AppointmentId
        </p>

        <p>
            <strong>Date:</strong>
            @Model.AppointmentDate.ToString("dd-MM-yyyy HH:mm")
        </p>

        <p>
            <strong>Status:</strong>
            @Model.Status
        </p>

        <p>
            <strong>Reason:</strong>
            @Model.Reason
        </p>

        <p>
            <strong>Patient:</strong>
            @Model.PatientName
            (@Model.PatientId)
        </p>

        <p>
            <strong>Doctor:</strong>
            @Model.DoctorName
            (@Model.DoctorId)
        </p>

        <form asp-action="Delete" method="post">

            <input type="hidden"
                   name="id"
                   value="@Model.AppointmentId" />

            <button type="submit"
                    class="btn btn-danger">
                Delete
            </button>

            <a asp-action="Index"
               class="btn btn-secondary">
                Cancel
            </a>

        </form>

    </div>
</div>