@model aug_17_mvc.Models.Appointment

@{
    ViewData["Title"] = "Create Appointment";
}

<h1>Create Appointment</h1>

<form asp-action="Create" method="post">

    <div class="mb-3">
        <label asp-for="AppointmentDate"
               class="form-label">
        </label>

        <input asp-for="AppointmentDate"
               type="datetime-local"
               class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Status"
               class="form-label">
        </label>

        <input asp-for="Status"
               class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Reason"
               class="form-label">
        </label>

        <textarea asp-for="Reason"
                  class="form-control">
        </textarea>
    </div>

    <div class="mb-3">
        <label asp-for="PatientId"
               class="form-label">
        </label>

        <input asp-for="PatientId"
               class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="DoctorId"
               class="form-label">
        </label>

        <input asp-for="DoctorId"
               class="form-control" />
    </div>

    <button type="submit"
            class="btn btn-success">
        Save
    </button>

    <a asp-action="Index"
       class="btn btn-secondary">
        Back
    </a>

</form>