@model HospitalMVC.Models.Appointment

@{
    ViewData["Title"] = "Appointment Details";
}

<h1>Appointment Details</h1>

<hr />

<dl class="row">

    <dt class="col-sm-3">
        Patient Id
    </dt>

    <dd class="col-sm-9">
        @Model.PatientId
    </dd>

    <dt class="col-sm-3">
        Doctor Id
    </dt>

    <dd class="col-sm-9">
        @Model.DoctorId
    </dd>

    <dt class="col-sm-3">
        Appointment Date
    </dt>

    <dd class="col-sm-9">
        @Model.AppointmentDate.ToString("dd-MM-yyyy HH:mm")
    </dd>

    <dt class="col-sm-3">
        Status
    </dt>

    <dd class="col-sm-9">
        @Model.Status
    </dd>

    <dt class="col-sm-3">
        Reason
    </dt>

    <dd class="col-sm-9">
        @Model.Reason
    </dd>

</dl>

<div>

    <a asp-action="Edit"
       asp-route-id="@Model.Id"
       class="btn btn-warning">
        Edit
    </a>

    <a asp-action="Index"
       class="btn btn-secondary">
        Back to List
    </a>

</div>