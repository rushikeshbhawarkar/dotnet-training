@model aug_17_mvc.Models.Appointment

@{
    ViewData["Title"] = "Appointment Details";
}

<h1>Appointment Details</h1>

<div class="card">
    <div class="card-body">

        <dl class="row">

            <dt class="col-sm-3">
                Appointment Id
            </dt>

            <dd class="col-sm-9">
                @Model.AppointmentId
            </dd>

            <dt class="col-sm-3">
                Appointment Date
            </dt>

            <dd class="col-sm-9">
                @Model.AppointmentDate.ToString("dd-MM-yyyy HH:mm")
            </dd>

            <dt class="col-sm-3">
                Status
            </dt>

            <dd class="col-sm-9">
                @Model.Status
            </dd>

            <dt class="col-sm-3">
                Reason
            </dt>

            <dd class="col-sm-9">
                @Model.Reason
            </dd>

            <dt class="col-sm-3">
                Patient
            </dt>

            <dd class="col-sm-9">
                @Model.PatientName
                (@Model.PatientId)
            </dd>

            <dt class="col-sm-3">
                Doctor
            </dt>

            <dd class="col-sm-9">
                @Model.DoctorName
                (@Model.DoctorId)
            </dd>

        </dl>

        <a asp-action="Edit"
           asp-route-id="@Model.AppointmentId"
           class="btn btn-warning">
            Edit
        </a>

        <a asp-action="Index"
           class="btn btn-secondary">
            Back
        </a>

    </div>
</div>