@model List<aug_17_mvc.Models.Doctor>

@{
    ViewData["Title"] = "Doctors";
}

<h1>Doctors</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Add Doctor</a>
</p>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Doctor Id</th>
            <th>Name</th>
            <th>Specialization</th>
            <th>Email</th>
            <th>Phone</th>
            <th>Department Id</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var doctor in Model)
        {
            <tr>
                <td>@doctor.DoctorId</td>
                <td>@doctor.Name</td>
                <td>@doctor.Specialization</td>
                <td>@doctor.Email</td>
                <td>@doctor.Phone</td>
                <td>@doctor.DepartmentId</td>
                <td>
                    <a asp-action="Details"
                       asp-route-id="@doctor.DoctorId"
                       class="btn btn-info">
                        Details
                    </a>

                    <a asp-action="Edit"
                       asp-route-id="@doctor.DoctorId"
                       class="btn btn-warning">
                        Edit
                    </a>

                    <a asp-action="Delete"
                       asp-route-id="@doctor.DoctorId"
                       class="btn btn-danger">
                        Delete
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>