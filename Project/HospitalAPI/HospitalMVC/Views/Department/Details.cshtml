@model aug_17_mvc.Models.Department

@{
    ViewData["Title"] = "Department Details";
}

<h1>Department Details</h1>

<div class="card">
    <div class="card-body">

        <dl class="row">

            <dt class="col-sm-3">
                Department Id
            </dt>

            <dd class="col-sm-9">
                @Model.DepartmentId
            </dd>

            <dt class="col-sm-3">
                Department Name
            </dt>

            <dd class="col-sm-9">
                @Model.DepartmentName
            </dd>

            <dt class="col-sm-3">
                Description
            </dt>

            <dd class="col-sm-9">
                @Model.Description
            </dd>

        </dl>

        <a asp-action="Edit"
           asp-route-id="@Model.DepartmentId"
           class="btn btn-warning">
            Edit
        </a>

        <a asp-action="Index"
           class="btn btn-secondary">
            Back
        </a>

    </div>
</div>