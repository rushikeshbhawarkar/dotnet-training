@{
    ViewData["Title"] = "Registration Success";
}

<h2>Automobile Registered Successfully</h2>

<p class="text-success">
    <strong>Vehicle Name:</strong> @ViewBag.VehicleName <br />
    <strong>Brand:</strong> @ViewBag.Brand
</p>

<a asp-action="Register" asp-controller="Automobile" class="btn btn-secondary">
    Register Another Vehicle
</a>